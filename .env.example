# Backend connection strings (used by backend/app/core/config.py)
# These are loaded automatically via pydantic-settings from environment variables.

# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://asset_user:asset_password@localhost:5432/asset_tracker

# MongoDB
MONGO_URL=mongodb://root:rootpassword@localhost:27017

# Polling config
POLL_INTERVAL=15.0
ENABLE_SPIKES=true
